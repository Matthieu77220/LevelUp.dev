      "UNRANKED": {
        "label": "Non classé",
        "meaning": "Compétence non commencée."
      },
      "E": {
        "label": "Débutant absolu",
        "meaning": "Point d'entrée pour une personne n'ayant jamais utilisé la compétence. Aucun prérequis implicite."
      },
      "D": {
        "label": "Bases acquises",
        "meaning": "Fondamentaux compris et exercices simples réalisables."
      },
      "C": {
        "label": "Autonome",
        "meaning": "Utilisation autonome sur des cas courants."
      },
      "B": {
        "label": "Avancé",
        "meaning": "Capable de traiter des projets et problèmes complexes."
      },
      "A": {
        "label": "Très avancé",
        "meaning": "Maîtrise poussée, architecture, optimisation et cas difficiles."
      },
      "S": {
        "label": "Maîtrise",
        "meaning": "Maîtrise avancée de la compétence. Les Boss servent à prouver l'intégration de plusieurs compétences."
      }
    }
