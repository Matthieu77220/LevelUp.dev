  "evaluation_engine": {
    "core_principle": "Correction déterministe autant que possible, sans dépendance à une IA payante.",
    "submission_types": {
      "INLINE": {
        "use_cases": [
          "beginner_exercises",
          "small_algorithmic_exercises",
          "early_rank_E_and_D_content"
        ],
        "fields": [
          "exerciseId",
          "language",
          "sourceCode",
          "submissionId"
        ]
      },
      "GIT": {
        "use_cases": [
          "advanced_projects",
          "multi_file_projects",
          "coop_projects",
          "bosses",
          "domain_final_bosses"
        ],
        "required_fields": [
          "repositoryUrl",
          "branch",
          "commitSha"
        ],
        "rule": "Une évaluation Git cible toujours un commit précis."
      }
    },
    "pipeline": [
      "submission_created",
      "static_constraint_check",
      "compile_or_build",
      "sandbox_execution",
      "visible_tests",
      "hidden_tests",
      "memory_checks_if_applicable",
      "performance_checks_if_applicable",
      "gate_evaluation",
      "result_persisted",
      "xp_and_progression_awarded_if_valid"
    ],
    "statuses": [
      "QUEUED",
      "RUNNING",
      "PASSED",
      "FAILED",
      "ERROR"
    ],
    "static_checks": [
      "required_files",
      "required_function_signature",
      "allowed_functions",
      "forbidden_functions",
      "forbidden_language_features",
      "project_structure_rules"
    ],
    "language_execution_examples": {
      "c": {
        "compile": "cc -Wall -Wextra -Werror main.c solution.c -o program",
        "run": "./program"
      },
      "cpp": {
        "compile": "c++ -Wall -Wextra -Werror -std=c++20 main.cpp solution.cpp -o program",
        "run": "./program"
      },
      "python": {
        "run": "python3 main.py"
      },
      "javascript": {
        "run": "node solution.js"
      },
      "go": {
        "run": "go test ./..."
      },
      "react_next": {
        "steps": [
          "install_dependencies",
          "npm_run_build",
          "unit_tests",
          "e2e_tests"
        ]
      }
    },
    "sandbox": {
      "mandatory": true,
      "rules": [
        "never_execute_user_code_in_main_server_process",
        "ephemeral_environment",
        "cpu_limit",
        "memory_limit",
        "execution_timeout",
        "network_disabled_by_default",
        "no_access_to_main_database",
        "no_access_to_application_secrets",
        "restricted_filesystem"
      ],
      "flow": [
        "main_platform",
        "job_queue",
        "evaluation_worker",
        "sandbox",
        "result"
      ]
    },
    "tests": {
      "visible_tests": true,
      "hidden_tests": true,
      "hidden_test_content_never_sent_to_browser": true,
      "feedback_can_reveal_category_without_exact_test": true
    },
    "memory_validation": {
      "languages": [
        "c",
        "cpp"
      ],
      "tools": [
        "AddressSanitizer",
        "Valgrind"
      ],
      "failures": [
        "memory_leak",
        "invalid_read",
        "invalid_write",
        "double_free",
        "use_after_free"
      ]
    },
    "performance_validation": {
      "enabled_for_advanced_content": true,
      "metrics": [
        "execution_time",
        "peak_memory",
        "dataset_size"
      ]
    },
    "web_project_validation": {
      "source": "git_commit",
      "steps": [
        "clone_repository",
        "checkout_commit",
        "install_dependencies",
        "build",
        "start_application",
        "api_tests",
        "unit_tests",
        "integration_tests",
        "playwright_e2e",
        "responsive_checks",
        "accessibility_checks",
        "security_checks"
      ]
    },
    "result_model": {
      "philosophy": "Préférer des gates obligatoires à une moyenne globale.",
      "rule": "Un gate obligatoire échoué bloque la validation.",
      "boss_rule": "Tous les gates obligatoires doivent être validés."
    },
    "feedback_by_rank": {
      "E": {
        "detail_level": "very_detailed",
        "description": "Feedback très pédagogique et précis."
      },
      "D": {
        "detail_level": "detailed",
        "description": "Feedback clair avec indications suffisantes."
      },
      "C": {
        "detail_level": "moderate",
        "description": "Feedback utile mais moins guidé."
      },
      "B": {
        "detail_level": "category_only",
        "description": "Indication de la catégorie du problème."
      },
      "A": {
        "detail_level": "minimal",
        "description": "Très peu d'informations."
      },
      "S": {
        "detail_level": "pass_fail_or_minimal",
        "description": "Presque uniquement validation ou échec."
      },
      "BOSS": {
        "detail_level": "gate_only",
        "description": "Le joueur voit principalement les gates échoués."
      }
    },
    "v1_mvp_priority": {
      "first_target": "C ft_strlen",
      "first_complete_pipeline": [
        "inline_editor",
        "submit_code",
        "forbidden_function_check",
        "compile",
        "sandbox",
        "visible_tests",
        "hidden_tests",
        "memory_check",
        "gate_result",
        "xp_award"
      ],
      "recommended_expansion_order": [
        "C",
        "C++",
        "Python",
        "JavaScript",
        "HTML_CSS",
        "React",
        "Git_projects"
      ]
    }
