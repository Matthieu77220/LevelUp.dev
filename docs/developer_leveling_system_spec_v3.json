  "git_progression": {
    "philosophy": "Git est une compétence transversale rendue obligatoire progressivement.",
    "initial_mode": {
      "git_required": false,
      "submission_mode": "INLINE_EDITOR",
      "description": "Les premiers modules utilisent l'éditeur intégré et les boutons Exécuter / Soumettre."
    },
    "unlock_trigger": {
      "type": "progression_gate",
      "description": "Avant les premiers projets avancés ou multi-fichiers, une quête principale introduit Git.",
      "main_quest_example": {
        "name": "Découvrir Git",
        "objectives": [
          "Comprendre le versionnement",
          "Initialiser un repository",
          "Utiliser git status",
          "Ajouter des fichiers avec git add",
          "Créer un commit",
          "Consulter l'historique"
        ]
      }
    },
    "rank_requirements": {
      "E": {
        "purpose": "Première autonomie avec un repository local.",
        "topics": [
          "Pourquoi Git existe",
          "Repository",
          "git init",
          "git status",
          "git add",
          "git commit",
          "git log",
          "modifier puis recommiter",
          ".gitignore"
        ],
        "required_for": [
          "advanced_projects",
          "multi_file_projects"
        ]
      },
      "D": {
        "purpose": "Collaboration de base.",
        "topics": [
          "git clone",
          "remote",
          "push",
          "pull",
          "branches",
          "git switch",
          "merge",
          "simple_conflict_resolution"
        ],
        "required_for": [
          "coop_projects",
          "team_projects"
        ]
      },
      "C": {
        "purpose": "Workflow professionnel de collaboration.",
        "topics": [
          "pull_requests",
          "code_review",
          "rebase",
          "merge_strategies",
          "tags",
          "stash",
          "revert",
          "reset",
          "history_analysis"
        ],
        "required_for": [
          "advanced_peer_review",
          "advanced_pull_request_workflows"
        ]
      },
      "B_A_S": {
        "purpose": "Maîtrise avancée de Git.",
        "topics": [
          "git_internals",
          "advanced_rebase",
          "bisect",
          "hooks",
          "worktrees",
          "recovery",
          "complex_conflict_resolution",
          "team_workflows"
        ]
      }
    },
    "gates": {
      "beginner_modules": "NONE",
      "first_advanced_projects": "E",
      "coop_projects": "D",
      "advanced_peer_review": "C",
      "block_bosses": "AT_LEAST_D_OR_PROJECT_SPECIFIC",
      "domain_final_bosses": "C_OR_HIGHER"
    },
    "prerequisite_types": {
      "technical": {
        "description": "Prérequis directement liés à la technologie ou au sujet étudié."
      },
      "developer": {
        "description": "Prérequis transversaux nécessaires pour travailler comme développeur, comme Git."
      }
    },
    "submission_evolution": {
      "before_git": {
        "source_type": "INLINE",
        "actions": [
          "RUN",
          "SUBMIT_CODE"
        ]
      },
      "after_git": {
        "source_type": "GIT",
        "required_submission_data": [
          "repository",
