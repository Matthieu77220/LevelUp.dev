{
  "name": "levelup-dev",
  "private": true,
  "scripts": {
    "dev:front": "npm --prefix frontend run dev",
    "dev:back": "go -C backend run ./cmd/api",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test:back": "go -C backend test ./...",
    "test:front": "npm --prefix frontend run test:e2e",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:status": "docker compose ps postgres",
    "db:migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File database/scripts/migrate.ps1",
    "db:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File database/scripts/verify.ps1"
  }
}
